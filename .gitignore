# ---------------------------
# VISUAL STUDIO
# ---------------------------
.vs/



# ---------------------------
# PYTHON
# ---------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# ---------------------------
# ENVIRONMENTS / SECRETS
# ---------------------------
.env
*.env
venv/

# Server-maintained per-environment config (ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS,
# INSTALLED_APPS, etc.) — edited directly on deployment targets, not synced via git.
config/settings.py


# ---------------------------
# BACKUPS
# ---------------------------
*.sql
*.dump
*.bak
2_db.sqlite3

# ---------------------------
# OS FILES
# ---------------------------
.DS_Store
Thumbs.db
db.sqlite3

node_modules/
staticfiles/
media/*
!media/.gitkeep

# ---------------------------
# EDITOR / AI-TOOL LOCAL CONFIG
# ---------------------------
.claude/
.vscode/
.idea/
.cursor/

# ---------------------------
# DOCS — keep README public, everything else local-only
# ---------------------------
*.md
!README.md

# Local-only notes/logs: every .txt is ignored except the dependency list
*.txt
!requirements.txt

# ---------------------------
# SOURCE DOCUMENTS — not app source, don't publish
# ---------------------------
*.pdf
*.docx

# ---------------------------
# DJANGO MIGRATIONS — not tracked; keep package markers only
# ---------------------------
**/migrations/*.py
!**/migrations/__init__.py

# ---------------------------
# DATABASE
# ---------------------------
*.sqlite3*

# ---------------------------
# WELL-KNOWN
# ---------------------------
.well-known/

# ---------------------------
# DEPLOYMENT — host-specific, not portable
# ---------------------------
passenger_wsgi.py